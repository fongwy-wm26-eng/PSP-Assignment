void searchPayment() {
	cout << "\n==== Search Payment ====\n";
	if (isEmptyPayments())
		return;

	string id;
	cout << "Enter Customer ID to search: ";
	cin >> id;
	clearInputBuffer();

	int ids = findPaymentIndex(id);
	if (ids == -1) {
		cout << "No payment record found for that Customer ID." << endl;
		return;
	}

	cout << fixed << setprecision(2);
	cout << "\nCustomer ID : " << payments[ids].customerID << endl;
	cout << "Total Amount: RM" << payments[ids].totalAmount << endl;
	cout << "Deposit     : RM" << payments[ids].deposit << endl;
	cout << "Balance     : RM" << payments[ids].balance << endl;
	cout << "Status      : " << payments[ids].status << endl;
} 

// ---- payments array helpers ----

bool isEmptyPayments() {
	if (paymentCount == 0) {
		cout << "No payment records available." << endl;
		return true;
	}
	return false;
}

int findPaymentIndex(string id) {
	for (int i = 0; i < paymentCount; i++) {
		if (payments[i].customerID == id) return i;
	}
	return -1; // not found
}

void savePaymentsToFile() {
	ofstream file("payments.txt");
	if (!file.is_open()) {
		cout << "Error: Could not open payments file for writing." << endl;
		return;
	}
	for (int i = 0; i < paymentCount; i++) {
		file << payments[i].customerID << endl;
		file << payments[i].totalAmount << endl;
		file << payments[i].deposit << endl;
		file << payments[i].balance << endl;
		file << payments[i].status << endl;
	}
	file.close();
}

void loadPaymentsFromFile() {
	ifstream file("payments.txt");
	if (!file.is_open())
		return;

	paymentCount = 0;
	string id, status;
	double amount, deposit, balance;

	while (paymentCount < MAX_PAYMENTS && getline(file, id)) {
		if (id.empty()) 
			continue;

		file >> amount >> deposit >> balance;
		file.ignore(); // clear leftover newline before the next getline()
		getline(file, status);

		payments[paymentCount].customerID = id;
		payments[paymentCount].totalAmount = amount;
		payments[paymentCount].deposit = deposit;
		payments[paymentCount].balance = balance;
		payments[paymentCount].status = status;
		paymentCount++;
	}
	file.close();
}

// Adds a new payment record, or overwrites the existing one for that
// customerID if they already have a record. Then saves to file.
void storeOrUpdatePayment(Payment p) {
	int ids = findPaymentIndex(p.customerID);
	if (ids != -1) {
		payments[ids] = p;
	}
	else if (paymentCount < MAX_PAYMENTS) {
		payments[paymentCount] = p;
		paymentCount++;
	}
	else {
		cout << "Error: Payment record limit reached." << endl;
		return;
	}
	savePaymentsToFile();
}

