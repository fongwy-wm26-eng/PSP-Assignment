#include <iostream>
#include <iomanip>


using namespace std;

struct Payment {
	double totalAmount;
	double deposit;
	double balance;
	string status;
};

void paymentMenu();
Payment processPayment(Payment p); // Function to process payment
void displayPaymentDetails(const Payment p); // Function to display payment details
void invoice(const Payment p); // Function to generate invoice
void updatePaymentStatus(); // Function to update payment status
void paymentHistory(); // Function to view payment history
void searchPayment(); // Function to search for a payment



void paymentMenu() {
	int choice;
	Payment p;
	do {
		cout << "==========================================" << endl;
		cout << "          Transaction Management         " << endl;
		cout << "==========================================" << endl;
		cout << "1. Process Payment" << endl;
		cout << "2. Display Payment Details" << endl;
		cout << "3. Generate Invoice" << endl;
		cout << "4. Update Payment Status" << endl;
		cout << "5. View Payment History" << endl;
		cout << "6. Search for a Payment" << endl;
		cout << "0. Return to Main Menu" << endl;
		cout << "==========================================" << endl;
		choice = getMenuChoice(1, 6);
		switch (choice) {
		case 1:
			p = processPayment(p);
			break;
		case 2:
			displayPaymentDetails(p);
			break;
		case 3:
			invoice(p);
			break;
		case 4:
			updatePaymentStatus();
			break;
		case 5:
			paymentHistory();
			break;
		case 6:
			searchPayment();
			break;
		default:
			cout << "Returning to Main Menu..." << endl;
		}
	} while (choice != 0);
}

Payment processPayment(Payment p) {
	int choice;

	cout << "\n===== Payment =====\n";
	cout << "Total Amount: RM" << p.totalAmount << endl;

	// Deposit is 50% of total amount
	p.deposit = p.totalAmount * 0.50;
	p.balance = p.totalAmount - p.deposit;

	cout << "Deposit (50%): RM" << p.deposit << endl;

	cout << "Deposit to pay: RM" << p.deposit << endl;
	cout << "Remaining balance need to be pay after services: RM" << p.balance << endl;


	cout << "\nChoose payment method: " << endl;
	cout << "1. Cash" << endl;
	cout << "2. Online Banking" << endl;
	cout << "3. E-Wallet" << endl;
	cout << "4. Help" << endl;
	cout << "0. Return to Payment Menu" << endl;
	cout << "Enter your choice: ";
	choice = getMenuChoice(1, 4);
	do {
		switch (choice) {
		case 1:
			cout << "\nPayment Method: Cash" << endl;
			cout << "Please pay the deposit amount in cash at our office." << endl;
			cout << "Press any key to continue..." << endl;
			cin.get();
			p.status = "Paid";
			cout << "\nPayment successful! Thank you for your payment." << endl;
			break;

		case 2:
			cout << "\nPayment Method: Online Banking" << endl;
			cout << "Please transfer the deposit amount to the following bank account: " << endl;
			cout << "Bank: Maybank" << endl;
			cout << "Account Number: 1234567890" << endl;
			cout << "Account Name: ABC Company" << endl;
			cout << "Please include your name and invoice number in the transfer reference." << endl;
			cout << "Press any key after you have finished the transfer..." << endl;
			cin.get();
			p.status = "Paid";
			cout << "\nPayment successful! Thank you for your payment." << endl;
			break;

		case 3:
			cout << "\nPayment Method: E-Wallet" << endl;
			cout << "Please transfer the deposit amount to the following e-wallet account: " << endl;
			cout << "Account Number: 0123456789" << endl;
			cout << "Account Name: ABC Company" << endl;
			cout << "Press any key to continue..." << endl;
			cin.get();
			p.status = "Paid";
			cout << "\nPayment successful! Thank you for your payment." << endl;
			break;

		case 4:
			cout << "\nPlease contact us if you need assistance." << endl;
			cout << "Email: abc@gmail.com" << endl;
			cout << "Phone: 012-3456789" << endl;
			cout << "Press any key to continue..." << endl;
			cin.get();
			break;

		default:
			cout << "\nReturning to Payment Menu..." << endl;
			break;
		}
	} while (choice <= 0 || choice > 5);

	return p;
}

void displayPaymentDetails(const Payment p) {
	int choice;
	cout << "\n===== Payment Details =====\n";
	cout << "Total Amount: RM" << p.totalAmount << endl;
	cout << "Deposit: RM" << p.deposit << endl;
	cout << "Balance: RM" << p.balance << endl;
	cout << "Status: " << p.status << endl;
	do {
		cout << "\n1. Update Payment Status" << endl;
		cout << "2. Generate Invoice" << endl;
		cout << "0. Return to Payment Menu" << endl;
		cout << "Enter your choice: ";
		choice = getMenuChoice(1, 2);
		if (choice == 1) {
			updatePaymentStatus();
			break;
		}
		else if (choice == 2) {
			invoice(p);
			break;
		}
		else if (choice == 0) {
			break;
		}
		else {
			cout << "Invalid choice. Please try again." << endl;
		}
	} while (choice <= 0 || choice > 2);
}

void invoice(const Payment p) {
	int choice;

	cout << "\n";
	cout << "========================================\n";
	cout << "              PET GROOMING\n";
	cout << "                 INVOICE\n";
	cout << "========================================\n";

	cout << fixed << setprecision(2);
	cout << "Total Amount       : RM" << p.totalAmount << endl;
	cout << "Deposit Paid (50%) : RM" << p.deposit << endl;
	cout << "Balance            : RM" << p.balance << endl;

	cout << "========================================\n";

	cout << "\nChoose invoice option:\n";
	cout << "1. Print Invoice\n";
	cout << "2. Email E-Invoice\n";
	cout << "3. Back\n";
	cout << "Enter your choice: ";
	choice = getMenuChoice(1, 3);

	switch (choice) {
	case 1:
		cout << "\nPrinting invoice...\n";
		cout << "Invoice printed successfully.\n";
		break;

	case 2:
		cout << "\nE-Invoice selected.\n";
		cout << "Sending invoice to email...\n";
		cout << "E-Invoice sent successfully.\n";
		break;

	case 3:
		cout << "\nReturning to main menu...\n";
		break;

	default:
		cout << "\nInvalid choice.\n";
	}
}
void updatePaymentStatus() {} // Function to update payment status
void paymentHistory() {} // Function to view payment history
void searchPayment() {} // Function to search for a payment

