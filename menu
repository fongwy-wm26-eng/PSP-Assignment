#include <iostream> 
#include <iomanip>  
#include "payment.cpp"

using namespace std;

void displayMenu() {
	int choice;
	cout << "Pet Grooming Service!" << endl;
	cout << "1. Services" << endl;
	cout << "2. Booking" << endl;
	cout << "3. Report (staff)" << endl;
	cout << "4. Login" << endl;
	cin >> choice;
	switch (choice) {
	case 1:
		cout << "Services selected." << endl;
		break;
	case 2:
		cout << "Booking selected." << endl;
		break;
	case 3:
		cout << "Report selected." << endl;
		break;
	case 4:
		cout << "Login selected." << endl;
		break;
	default:
		cout << "Invalid choice. Please try again." << endl;
		displayMenu();
		break;
	}
}

int main() {
	displayMenu();
	return 0;
}
