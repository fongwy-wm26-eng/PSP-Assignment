// This works as an Input Filter
int getMenuChoice(int low, int high) {
	int choice = 0;
	bool valid = false;
	while (!valid) {
		cout << "\nWhat are you looking for ? " << endl;
		cin >> choice;
		if (cin.fail()) {
			cout << "Invalid, please try again!." << endl;
			clearInputBuffer();
		}
		else if (choice == 0) {
			clearInputBuffer();
			valid = true;
		}
		else if (choice < low || choice > high) {
			cout << "Please choose between (" << low << " and " << high << ")" << endl;
			clearInputBuffer();
		}
		else {
			clearInputBuffer();
			valid = true;
		}
	}
	return choice;
}

// Clearing input buffer to avoid \n bug
void clearInputBuffer() {
	cin.clear();
	cin.ignore(10000, '\n');
}

