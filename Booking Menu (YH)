float getValidTime() {
	float time;

	while (true) {
		cout << "\nPlease enter the booking time in 24-hour clock (e.g. 15.00) :";
		cin >> time;

		if (cin.fail()) {										//for input such as abc while facing float
			clearInputBuffer();
			cout << "Invalid input. Please enter a valid time.\n";
		}
		else {
			int hour = (int)time;								//example : 23.45 (float) -> 23 (int)(hour)
 			int minute = (int)((time - hour) * 100);			//example : (23.45 - 23) * 100 = 45 (int)(minutes)

			if (hour >= 0 && hour <= 23 &&
				minute >= 0 && minute <= 59) {
				return time;
			}
			else {
				cout << "Invalid time. Please enter between 00.00 and 23.59.\n";
			}
		}
	}
}

double getServicePrice(int serviceNumber) {
	ifstream file("data.txt"); //get newest price in the file

	if (!file.is_open()) {
		cout << "Unable to open service file.\n";
		return 0.0;
	}

	string serviceID;
	string serviceName;
	string description;
	double price;

	for (int i = 1; i <= 7; i++) {

		getline(file, serviceID);		//read serviceID and so on
		getline(file, serviceName);

		file >> price;				   //this will read the price from file and put it out
		file.ignore();				   //cover the enter input

		getline(file, description);

		if (i == serviceNumber) {	   //close file and return price when equal
			file.close();
			return price;
		}
	}

	file.close();
	return 0.0;
}

void calculateTotal(Booking& b) {

	b.totalAmount = 0.0;

	for (int service = 0; service < 7; service++) {

		int index = service * 2;		//two time slot per service
		double price = getServicePrice(service + 1);		//get price need 1-7 not 0-6

		if (b.times[index] != 0) {	   //determine if booking time slot taken or not
			b.totalAmount += price;
		}

		if (b.times[index + 1] != 0) {//determine second booking time slot taken or not
			b.totalAmount += price;
		}
	}
}

void saveBooking(Booking b) {
	ofstream file("bookings.txt", ios::app);		//open booking.txt file to write data (start from behind

	if (!file.is_open()) {
		cout << "Unable to open booking file.\n";
		return;
	}

	file << b.customerID << endl;

	for (int i = 0; i < 14; i++) {		//save all the booking time customer wanted  (wether 0 or not) and data
		file << b.times[i] << endl;
	}

	file << b.totalBooking << endl;
	file << b.totalCancel << endl;
	file << b.totalAmount << endl;

	file.close();

	cout << "\nBooking successfully saved.\n";
}

void updateBooking(Booking b) {

	ifstream oldFile("bookings.txt");
	ofstream newFile("temp.txt");

	if (!oldFile.is_open()) {
		cout << "Unable to open booking file.\n";
		return;
	}

	if (!newFile.is_open()) {
		cout << "Unable to create temporary file.\n";
		oldFile.close();								//close both file
		return;
	}

	Booking temp;

	while (getline(oldFile, temp.customerID)) {

		for (int i = 0; i < 14; i++) {
			oldFile >> temp.times[i];
		}

		oldFile >> temp.totalBooking;
		oldFile >> temp.totalCancel;
		oldFile >> temp.totalAmount;

		oldFile.ignore();

		if (temp.customerID == b.customerID) {		// If customer ID matches, use the updated booking status
			temp = b;
		}

		// Write Booking into temporary file
		newFile << temp.customerID << endl;

		for (int i = 0; i < 14; i++) {
			newFile << temp.times[i] << endl;
		}

		newFile << temp.totalBooking << endl;
		newFile << temp.totalCancel << endl;
		newFile << temp.totalAmount << endl;
	}

	oldFile.close();
	newFile.close();

	remove("bookings.txt");					// Replace old file with updated file
	rename("temp.txt", "bookings.txt");

	cout << "\nBooking file successfully updated.\n";
}

