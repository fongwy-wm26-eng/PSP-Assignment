void grandTotal() {
	ifstream file("bookings.txt");

	if (!file.is_open()) {
		cout << "Unable to open booking file." << endl;
		return;
	}

	string customerID;
	float times[14];
	int totalService[7] = { 0 };
	int grandTotal = 0;

	while (getline(file, customerID)) {

		for (int i = 0; i < 14; i++) {
			file >> times[i];
		}

		int totalBooking;
		int totalCancel;
		double totalAmount;

		file >> totalBooking;
		file >> totalCancel;
		file >> totalAmount;

		file.ignore();					//not going to count in these

		for (int i = 0; i < 7; i++) {

			if (times[i * 2] != 0) {
				totalService[i]++;
				grandTotal++;
			}

			if (times[i * 2 + 1] != 0) {			//each service two time slot, so determine both of it
				totalService[i]++;
				grandTotal++;
			}
		}
	}

	file.close();

	string serviceName[7] = {
		"Basic Bath",			//service name [0] to [6]
		"Hair Trimming",
		"Nail Clipping",
		"Teeth Cleaning",
		"Ear Cleaning",
		"Full Grooming",
		"Flea Treatment"
	};

	cout << "==========================================" << endl;
	cout << "       ALL CUSTOMER SERVICE TOTAL        " << endl;
	cout << "==========================================" << endl;

	for (int i = 0; i < 7; i++) {
		cout << serviceName[i] << "\t: " << totalService[i] << endl;			//display all respective service and booking
	}																			//situation

	cout << "==========================================" << endl;
	cout << "Grand Total\t: " << grandTotal << endl;
	cout << "==========================================" << endl;
}

