void addService()
{
	cout << "==============================" << endl;
	cout << "        Add New Service       " << endl;
	cout << "==============================" << endl;

	if (serviceCount >= 100)
	{
		cout << "Service list is full!" << endl;
		return;
	}
	bool validateID;

	do
	{
		validateID = true;

		cout << "Enter Service ID: ";
		cin >> services[serviceCount].serviceID;

		// User enters 1 → return to main menu
		if (services[serviceCount].serviceID == "1")
		{
			return;
		}

		// Check length
		if (services[serviceCount].serviceID.length() != 4)
		{
			cout << "Invalid Service ID. Please enter S001 to S099." << endl;
			continue;
		}

		// Check first character
		if (services[serviceCount].serviceID[0] != 'S')
		{
			cout << "Invalid Service ID. Please enter S001 to S099." << endl;
			continue;
		}

		// Check second character must be 0
		if (services[serviceCount].serviceID[1] != '0')
		{
			cout << "Invalid Service ID. Please enter S001 to S099." << endl;
			continue;
		}

		// Check last two characters are digits
		if (!isdigit(services[serviceCount].serviceID[2]) ||
			!isdigit(services[serviceCount].serviceID[3]))
		{
			cout << "Invalid Service ID. Please enter S001 to S099." << endl;
			continue;
		}

		bool duplicate = false;

		for (int i = 0; i < serviceCount; i++)
		{
			if (services[i].serviceID == services[serviceCount].serviceID)
			{
				duplicate = true;
				break;
			}
		}

		if (duplicate)
		{
			cout << "Service ID already exists. Please enter another Service ID." << endl;
			validateID = true;
			continue;
		}

		validateID = false;

	} while (validateID);
	cout << "Enter Service Name: ";
	cin.ignore();
	getline(cin, services[serviceCount].serviceName);

	cout << "Enter Description: ";
	getline(cin, services[serviceCount].description);

	bool validPrice = false;

	do{
		cout << "Enter Price: RM";
		if (cin >> services[serviceCount].price){
			if (services[serviceCount].price > 0){
				validPrice = true;
			}
			else{
				cout << "Invalid price. Please enter a positive number." << endl;
			}
		}
		else{
			cout << "Invalid input. Please enter numbers only." << endl;

			cin.clear();
			cin.ignore(1000, '\n');
		}

	} while (!validPrice);	
	
	serviceCount++;

	saveService();

	cout << endl << "\nService added successfully!" << endl;

	do {
		cout << "\n" << "1.Add another service" << endl;
		cout << "2.Return to main menu" << endl;
		cout << "0. Exit" << endl;
		cout << "Select the number of Service: ";
		cout << endl;

		if (!(cin >> returnNumber)) {
	
			cout << endl << "Invalid choice. Please try again." << endl;
			cin.clear();
			cin.ignore(1000, '\n');

			continue;
		}

			if (returnNumber == '1') {
				cout << endl;
				typeService();
				cout << endl;
				addService();
				cout << endl;
			}
			else if (returnNumber == '2') {
				cout << endl;
				return;
				cout << endl;
			}
			else if (returnNumber == '0') {
				cout << "Exiting the program..." << endl;
				exit(0);
			}
			else {
				cout << endl << "Invalid choice. Please try again." << endl;
				cin.ignore();
			}

			
		
	} while (returnNumber != 0 && returnNumber !=1 && returnNumber != 2);
	
}

