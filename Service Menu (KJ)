void addService() {
	cout << "Select the number of service: ";
	cin >> serviceNumber;
	cin.ignore(); // Clear the input buffer
	string serviceName;
	switch(serviceNumber) {
		case 1:
			serviceName = "Basic Bath";
			servicePrice = 30.00;
			cout << endl << "Service added successfully!" << endl;
			break;
		case 2:
			serviceName = "Hair Trimming";
			servicePrice = 40.00;
			cout << endl << "Service added successfully!" << endl;
			break;
		case 3:
			serviceName = "Nail Clipping";
			servicePrice = 15.00;
			cout << endl << "Service added successfully!" << endl;
			break;
		case 4:
			serviceName = "Teeth Cleaning";
			servicePrice = 15.00;
			cout << endl << "Service added successfully!" << endl;
			break;
		case 5:
			serviceName = "Ear Cleaning";
			servicePrice = 15.00;
			cout << endl << "Service added successfully!" << endl;
			break;
		case 6:
			serviceName = "Full Grooming";
			servicePrice = 70.00;
			cout << endl << "Service added successfully!" << endl;
			break;
		case 7:
			serviceName = "Flea Treatment";
			servicePrice = 50.00;
			cout << endl << "Service added successfully!" << endl;
			break;
		case 0:
			cout << "Exiting add service...." << endl;
			return petgroomingSystem();
		default:
			cout << "Invalid service number. Please enter a valid number" << endl;
			return;
	}
	cout << "Service '" << serviceName << "' added with price RM" << fixed << setprecision(2) << servicePrice << endl;
