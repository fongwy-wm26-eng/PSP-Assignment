		cin.ignore();
		getline(cin, services[i].serviceName);
		cin.ignore();
		cin >> services[i].price;
		cin.ignore();
		getline(cin, services[i].description);
	}
	file.close();
}

void saveService()
{
	ofstream file("data.txt");

	for (int i = 0; i < serviceCount; i++)
	{
		file << services[i].serviceID << endl;
		file << services[i].serviceName << endl;
		file << services[i].price << endl;
		file << services[i].description << endl;
	}

	file.close();
}




