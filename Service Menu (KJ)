void deleteService() {
	string serviceID;
	char confirmation;
	cout << "================================================================" << endl;
	cout << "                        Delete service " << endl;
	cout << "================================================================" << endl;

	do {
		found = false;

		cout << "Please Enter Service ID(S001 - S099) Or Enter 1 To Exit To Main Menu: " << endl;
		cin >> serviceID;

		if (serviceID == "1") {
			cout << endl;
			return;
		}

		for (int i = 0; i < serviceCount; i++)
		{
			if (services[i].serviceID == serviceID)
			{
				found = true;

				cout << endl << "Service Found!" << endl;

				cout << left;

				cout << setw(15) << "Service ID"
					<< setw(20) << "Service Name"
					<< setw(60) << "Description"
					<< setw(10) << "Price" << endl;

				for (int i = 0; i < serviceCount; i++) {
					if (services[i].serviceID == serviceID) {
						cout << setw(15) << services[i].serviceID
							<< setw(20) << services[i].serviceName
							<< setw(60) << services[i].description
							<< "RM" << fixed << setprecision(2)
							<< services[i].price << endl;
					}
				}
				do {
					cout << "Are you sure you want to delete this service? (Y/N): ";
					cin >> confirmation;

					switch (confirmation) {
					case 'Y':
					case 'y':
						for (int j = i; j < serviceCount - 1; j++)
						{
							services[j] = services[j + 1];
						}

						serviceCount--;

						saveService();


						cout << endl << "Service deleted successfully!" << endl;
						break;
					case 'N':
					case 'n':
						cout << endl << "Service deletion canceled." << endl;
						break;
					default:
						cout << endl << "Invalid choice. Please try again." << endl;
						cin.ignore();
					}
				} while (confirmation != 'Y' && confirmation != 'y' && confirmation != 'N' && confirmation != 'n');

				break;
			}
		}

		if (!found)
		{
			cout << endl << "Invalid Service ID. Please try again.\n";
		}

	} while (!found);

	do {
		cout << endl << "1.Delete another service" << endl;
		cout << "2.Return to main menu" << endl;
		cout << "0. Exit" << "\n" << endl;
		cout << "Select the number of Service: ";
		cin >> deleteNumber;

		switch (deleteNumber) {
		case '1':
			cout << endl;
			deleteService();
			break;
		case '2':
			cout << endl;
			return;
			break;
		case '0':
			cout << "Exiting the program..." << endl;
			exit(0);
		default:
			cout << "Invalid choice. Please try again." << endl << endl;
			cin.ignore();
		}
	} while (deleteNumber != '1' && deleteNumber != '2' && deleteNumber != '0');
	


}

