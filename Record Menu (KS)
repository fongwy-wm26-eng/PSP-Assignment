		cout << "==========================================" << endl;
		cout << "1. Add Customer \n2. Update Customer \n3. Delete Customer \n4. Search Customer \n5. Display All Customers\n0. Exit" << endl;
		choiceRMM = getMenuChoice(1, 5);
		switch (choiceRMM) {
		case 1: addCustomer();
			break;
		case 2: updateCustomer();
			break;
		case 3: deleteCustomer();
			break;
