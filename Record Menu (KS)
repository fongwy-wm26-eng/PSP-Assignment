			break;
		case 5: displayAllCustomers();
			break;
		}

	} while (choiceRMM != 0);
}

void addCustomer() {
	cout << endl;
	cout << "==========================================" << endl;
	cout << "               Add Customer" << endl;
	cout << "==========================================" << endl;

	if (customerCount >= MAX_CUSTOMERS) {
		cout << "Error: Customer limit reached. Cannot add more customers." << endl;
		return;
	}

	CustomerInfo newCustomer;

	//=====Enter Customer ID with validation=====
	do {
		cout << "Enter Customer ID: ";
		cin >> newCustomer.id;

		if (newCustomer.id.empty()) {
			cout << "Customer ID cannot be empty. Please try again." << endl;
			continue;
		}
		else if (isDuplicateID(newCustomer.id)) {
			cout << "Customer ID already exists. Please enter a unique ID." << endl;
			continue;
		}
		else {
			break;
		}
	} while (true);

	clearInputBuffer(); //put this outside loop to run once only

	//=====Enter Customer Name with validation=====
	do {
		cout << "Enter Customer Name: ";
		getline(cin, newCustomer.name);

		if (newCustomer.name.empty()) {
			cout << "Customer Name cannot be empty. Please try again." << endl;
			continue;
		}
		else {
			break;
		}
	} while (newCustomer.name.empty());

	//=====Enter Customer Phone with validation=====
	do {
		cout << "Enter Customer Phone: ";
		getline(cin, newCustomer.phone);
		if (newCustomer.phone.empty()) {
			cout << "Customer Phone cannot be empty. Please try again." << endl;
			continue;
		}
		else {
			break;
		}
	} while (newCustomer.phone.empty());

	//=====Enter Pet Name with validation=====
	do {
		cout << "Enter Pet Name: ";
		getline(cin, newCustomer.petName);
		if (newCustomer.petName.empty()) {
			cout << "Pet Name cannot be empty. Please try again." << endl;
			continue;
		}
		else {
			break;
		}
	} while (newCustomer.petName.empty());

	//=====Enter Pet Type with Enum function=====
	newCustomer.petType = selectPetType();

	customers[customerCount] = newCustomer;
	customerCount++;

	saveAllToFile();
	cout << "\nCustomer added successfully!" << endl;
}


void updateCustomer(){
	cout << endl;
	cout << "=========================================" << endl;
	cout << "             Update Customer" << endl;
	cout << "=========================================" << endl;

	if (isEmpty()) return;

	int index = findCustomerIndex("update");
	if (index == -1) {
		return;}

	cin.ignore();
	cout << "Updating details for Customer ID: " << customers[index].id << endl;

	cout << "Enter New Customer Name: ";
	getline(cin, customers[index].name);

	cout << "Enter New Customer Phone: ";
	getline(cin, customers[index].phone);

	cout << "Enter New Pet Name: ";
	getline(cin, customers[index].petName);

	customers[index].petType = selectPetType();

	saveAllToFile();
	cout << "\nCustomer record updated successfully!" << endl;
}


void deleteCustomer() {
	cout << endl;
	cout << "=========================================" << endl;
	cout << "             Delete Customer" << endl;
	cout << "=========================================" << endl;

	if (isEmpty()) return;

	int index = findCustomerIndex("delete");
	if (index == -1) {
		return;
	}

	for (int i = index; i < customerCount - 1; i++) {
		customers[i] = customers[i + 1];
	}
	customerCount--;

	saveAllToFile();
	cout << "\nCustomer record deleted successfully!" << endl;
}

void searchCustomer() {
	cout << endl;
	cout << "=========================================" << endl;
	cout << "             Search Customer" << endl;
	cout << "=========================================" << endl;

	if (isEmpty()) return;

	int index = findCustomerIndex("search");
	if (index == -1) return;

	cout << "\nCustomer ID: " << customers[index].id;
	cout << "\nCustomer Name: " << customers[index].name;
	cout << "\nCustomer Phone: " << customers[index].phone;
	cout << "\nPet Name: " << customers[index].petName;
	cout << "\nPet Type: " << petTypeToString(customers[index].petType) << endl;
}

void displayAllCustomers() {
	cout << endl;
	cout << "=========================================" << endl;
	cout << "         Displaying All Customer" << endl;
	cout << "=========================================" << endl;

	if (isEmpty()) return;

	for (int i = 0; i < customerCount; i++) {
		cout << "\nCustomer [" << (i + 1) << "]";
		cout << "\nCustomer ID: " << customers[i].id;
		cout << "\nCustomer Name: " << customers[i].name;
		cout << "\nCustomer Phone: " << customers[i].phone;
		cout << "\nPet Name: " << customers[i].petName;
		cout << "\nPet Type: " << petTypeToString(customers[i].petType) << endl;
		cout << "-----------------------------------------";
	}
	cout << endl;
}

int main() {
	loadFromFile();
	recordMenu();
	return 0;
}
