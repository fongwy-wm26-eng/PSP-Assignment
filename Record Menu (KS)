#include <iostream>
#include <iomanip>
#include <string>
#include <fstream>

using namespace std;


//Enum
enum PetType {
	DOG = 1,
	CAT,
};

//Customer Struct (Khai Siang)
struct CustomerInfo {
	string id = "";
	string name = "";
	string phone = "";
	string petName = "";
	PetType petType = DOG;
};


