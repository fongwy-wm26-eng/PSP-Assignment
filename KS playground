void deleteCustomer() {
	cout << endl;
	cout << "=========================================" << endl;
	cout << "             Delete Customer" << endl;
	cout << "=========================================" << endl;

	if (isEmpty()) return;

	int index = findCustomerIndex("delete");
	if (index == -1) {
		return;
	}

	for (int i = index; i < customerCount - 1; i++) {
		customers[i] = customers[i + 1];
	}
	customerCount--;

	saveAllToFile();
	cout << "\nCustomer record deleted successfully!" << endl;
}

