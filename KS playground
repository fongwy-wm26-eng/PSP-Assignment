int findCustomerIndex(string actionName) {
	string targetID;
	cout << "Enter Customer ID to " << actionName << ": ";
	cin >> targetID;

	int targetIndex = -1;

	for (int i = 0; i < customerCount; i++) {
		if (customers[i].id == targetID) {
			targetIndex = i;
			break;
		}
	}

	if (targetIndex == -1) {
		cout << "Customer ID not found." << endl;
		return -1;
	}

	return targetIndex;
}

PetType selectPetType() {
	int choice;
	while (true) {
		cout << "Select Pet Type:" << endl;
		cout << "1. Dog" << endl;
		cout << "2. Cat" << endl;
		cout << "Enter choice: ";
		cin >> choice;

		if (cin.fail() || choice < 1 || choice > 2) {
			cout << "Invalid choice. Please enter a number between 1 and 2.\n" << endl;
			clearInputBuffer();
		}
		else {
			clearInputBuffer();
			return static_cast<PetType>(choice); // turn the integer choice into PetType enum
		}
	}
}

string petTypeToString(PetType type) {
	switch (type) {
	case DOG:   return "Dog";
	case CAT:   return "Cat";
	default:    return "Invalid input";
	}
}

PetType stringToPetType(string typeStr) {
	if (typeStr == "Dog") return DOG;
	if (typeStr == "Cat") return CAT;
	return DOG;
}

void loadFromFile() {
	ifstream file("customers.txt");
	if (!file.is_open()) {
		return;
	}

	customerCount = 0;
	string id, name, phone, petName, petTypeStr;

	while (customerCount < MAX_CUSTOMERS && getline(file, id)) {
		if (id.empty()) continue;

		getline(file, name);
		getline(file, phone);
		getline(file, petName);
		getline(file, petTypeStr);

		customers[customerCount].id = id;
		customers[customerCount].name = name;
		customers[customerCount].phone = phone;
		customers[customerCount].petName = petName;
		customers[customerCount].petType = stringToPetType(petTypeStr);

		customerCount++;
	}

	file.close();
}

