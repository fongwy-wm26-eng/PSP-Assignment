// Definitions
PetType selectPetType() {
	int choice;
	while (true) {
		cout << "Select Pet Type:" << endl;
		cout << "1. Dog" << endl;
		cout << "2. Cat" << endl;
		cout << "3. Other" << endl;
		cout << "Enter choice: ";
		cin >> choice;

		if (cin.fail() || choice < 1 || choice > 3) {
			cout << "Invalid choice. Please enter a number between 1 and 3.\n" << endl;
			clearInputBuffer();
		}
		else {
			clearInputBuffer();
			return static_cast<PetType>(choice); // turn the integer choice into PetType enum
		}
	}
}

string petTypeToString(PetType type) {
	switch (type) {
	case DOG:   return "Dog";
	case CAT:   return "Cat";
	case OTHER: return "Other";
	default:    return "Invalid input";
	}
}

PetType stringToPetType(string typeStr) {
	if (typeStr == "Dog") return DOG;
	if (typeStr == "Cat") return CAT;
	return DOG;
}

void saveAllToFile() {
	ofstream file("customers.txt");
	if (!file.is_open()) {
		cout << "Error: Could not open file for writing." << endl;
		return;
	}

	for (int i = 0; i < customerCount; i++) {
		file << customers[i].id << endl;
		file << customers[i].name << endl;
		file << customers[i].phone << endl;
		file << customers[i].petName << endl;
		file << petTypeToString(customers[i].petType) << endl;
	}
	file.close();
}

int findCustomerIndex(string actionName) {
	string targetID;
	cout << "Enter Customer ID to " << actionName << ": ";
	cin >> targetID;

	int targetIndex = -1;

	for (int i = 0; i < customerCount; i++) {
		if (customers[i].id == targetID) {
			targetIndex = i;
			break;
		}
	}

	if (targetIndex == -1) {
		cout << "Customer ID not found." << endl;
		return -1;
	}

	return targetIndex;
}

bool isEmpty() {
	if (customerCount == 0) {
		cout << "No customer records available." << endl;
		cout << "Press [ENTER] to return to Customer Record Management page.\n";
		clearInputBuffer();
		return true;
	}
	return false;
}

bool isDuplicateID(string id) {
	for (int i = 0; i < customerCount; i++) {
		if (customers[i].id == id) {
			return true;
		}
	}
	return false;
}

