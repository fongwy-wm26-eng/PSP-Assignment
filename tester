void load_service()
{
	ifstream file("data.txt");

	if (!file)
	{
		return;
	}

	serviceCount = 0;

	while (serviceCount < 100 && getline(file, services[serviceCount].serviceID))
	{
		getline(file, services[serviceCount].serviceName);

		file >> services[serviceCount].price;
		file.ignore();

		getline(file, services[serviceCount].description);

		serviceCount++;
	}

	file.close();
}

