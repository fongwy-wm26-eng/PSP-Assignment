				} while (confirmation != 'Y' && confirmation != 'y' && confirmation != 'N' && confirmation != 'n');

				break;
			}
		}

		if (!found)
		{
			cout << endl << "Invalid Service ID. Please try again.\n";
		}

	} while (!found);

