bool findBooking(string customerID, Booking& b) {

	ifstream file("bookings.txt");

	if (!file.is_open()) {
		cout << "Unable to open booking file.\n";
		return false;
	}

	while (getline(file, b.customerID)) {	//read customer id in booking file

		for (int i = 0; i < 14; i++) {		//read all the data
			file >> b.times[i];
		}

		file >> b.totalBooking;
		file >> b.totalCancel;
		file >> b.totalAmount;

		file.ignore();

		if (b.customerID == customerID) {	//close and return when customer id match
			file.close();
			return true;
		}
	}

	file.close();

	return false;
}

