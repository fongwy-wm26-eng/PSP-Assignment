	cout << "Deposit     : RM" << payments[ids].deposit << endl;
	cout << "Balance     : RM" << payments[ids].balance << endl;
	cout << "Status      : " << payments[ids].status << endl;
}

// ---- payments array helpers ----

bool isEmptyPayments() {
	if (paymentCount == 0) {
		cout << "No payment records available." << endl;
		return true;
	}
	return false;
}

int findPaymentIndex(string id) {
	for (int i = 0; i < paymentCount; i++) {
		if (payments[i].customerID == id) return i;
	}
	return -1; // not found
}

void savePaymentsToFile() {
	ofstream file("payments.txt");
	if (!file.is_open()) {
		cout << "Error: Could not open payments file for writing." << endl;
		return;
	}
	for (int i = 0; i < paymentCount; i++) {
		file << payments[i].customerID << endl;
		file << payments[i].totalAmount << endl;
		file << payments[i].deposit << endl;
		file << payments[i].balance << endl;
		file << payments[i].status << endl;
	}
	file.close();
}

void loadPaymentsFromFile() {
	ifstream file("payments.txt");
	if (!file.is_open())
		return;

	paymentCount = 0;
	string id, status;
	double amount, deposit, balance;

	while (paymentCount < MAX_PAYMENTS && getline(file, id)) {
		if (id.empty())
			continue;

		file >> amount >> deposit >> balance;
		file.ignore(); // clear leftover newline before the next getline()
		getline(file, status);

		payments[paymentCount].customerID = id;
		payments[paymentCount].totalAmount = amount;
		payments[paymentCount].deposit = deposit;
		payments[paymentCount].balance = balance;
		payments[paymentCount].status = status;
		paymentCount++;
	}
	file.close();
}

// Adds a new payment record, or overwrites the existing one for that
// customerID if they already have a record. Then saves to file.
void storeOrUpdatePayment(Payment p) {
	int ids = findPaymentIndex(p.customerID);
	if (ids != -1) {
		payments[ids] = p;
	}
	else if (paymentCount < MAX_PAYMENTS) {
		payments[paymentCount] = p;
		paymentCount++;
	}
	else {
		cout << "Error: Payment record limit reached." << endl;
		return;
	}
	savePaymentsToFile();
}
// ---- lookup helpers: read other modules' .txt files directly ----

string getCustomerName(string id) {
	ifstream file("customers.txt");
	if (!file.is_open()) return "";

	string fileID, name, phone, petName, petType;
	while (getline(file, fileID)) {
		getline(file, name);
		getline(file, phone);
		getline(file, petName);
		getline(file, petType);

		if (fileID == id) {
			file.close();
			return name;
		}
	}
	file.close();
	return "";
}

void getServiceInfoByPosition(int position, string& nameOut, double& priceOut) {
	nameOut = "";
	priceOut = -1;

	ifstream file("data.txt");
	if (!file.is_open()) return;

	string id, name, description;
	double price;
	int i = 0;

	while (getline(file, id)) {
		getline(file, name);
		file >> price;
		file.ignore(); // eat trailing newline before next getline()
		getline(file, description);

		if (i == position) {
			nameOut = name;
			priceOut = price;
			file.close();
			return;
		}
		i++;
	}
	file.close();
}

double showCustomerBooking(string id) {
	ifstream file("bookings.txt");
	if (!file.is_open())
		return -1;

	string fileID;
	while (getline(file, fileID)) {
		float times[14];
		for (int i = 0; i < 14; i++)
			file >> times[i];

		int totalBooking, totalCompleted;
		double totalAmount;
		file >> totalBooking >> totalCompleted >> totalAmount;
		file.ignore(); // eat trailing newline before next getline()

		if (fileID == id) {
			file.close();
			cout << fixed << setprecision(2);
			for (int i = 0; i < 14; i++) {
				if (times[i] != 0) {
					string sName;
					double price;
					getServiceInfoByPosition(i / 2, sName, price);

					cout << sName << " - Booking Time: " << times[i];
					if (price != -1) {
						cout << " - RM" << price;
					}
					else {
						cout << " - (price not found)";
					}
					cout << endl;
				}
			}
			return totalAmount;
		}
	}
	file.close();
	return -1;
}


