Payment updatePaymentStatus(Payment p) {
	int choice;

	cout << "\n===== Update Payment Status =====" << endl;

	if (p.customerID.empty()) {
		cout << "Enter Customer ID: ";
		cin >> p.customerID;
		clearInputBuffer();
		int ids = findPaymentIndex(p.customerID);
		if (ids == -1) {
			cout << "No payment record found for that Customer ID." << endl;
			return p;
		}
		p = payments[ids];
	}

	cout << "Current Status: " << p.status << endl;
	cout << "\nSelect new payment status:" << endl;
	cout << "1. Pending" << endl;
	cout << "2. Deposit Paid" << endl;
	cout << "3. Fully Paid" << endl;
	cout << "4. Failed" << endl;
	cout << "0. Back" << endl;
	choice = getMenuChoice(1, 4);
	switch (choice) {
	case 1:
		p.status = "Pending";
		cout << "Payment status updated to Pending." << endl;
		break;
	case 2:
		p.status = "Deposit Paid";
		cout << "Payment status updated to Deposit Paid." << endl;
		break; // FIX: was falling through into case 3 before
	case 3:
		p.status = "Fully Paid";
		cout << "Payment status updated to Fully Paid." << endl;
		break;
	case 4:
		p.status = "Failed";
		cout << "Payment status updated to Failed." << endl;
		break;
	}
	return p;
}

