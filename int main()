	string fileID, name, phone, petName, petType;
	while (getline(file, fileID)) {
		getline(file, name);
		getline(file, phone);
		getline(file, petName);
		getline(file, petType);

		if (fileID == id) {
			file.close();
			return name;
		}
	}
