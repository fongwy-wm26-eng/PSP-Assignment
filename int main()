	return "";
}

void getServiceInfoByPosition(int position, string& nameOut, double& priceOut) {
	nameOut = "";
	priceOut = -1;

	ifstream file("data.txt");
	if (!file.is_open()) return;

	string id, name, description;
	double price;
	int i = 0;

	while (getline(file, id)) {
		getline(file, name);
		file >> price;
		file.ignore(); // eat trailing newline before next getline()
		getline(file, description);

		if (i == position) {
			nameOut = name;
			priceOut = price;
			file.close();
			return;
		}
		i++;
	}
	file.close();
}

double showCustomerBooking(string id) {
	ifstream file("bookings.txt");
	if (!file.is_open())
		return -1;

	string fileID;
	while (getline(file, fileID)) {
		float times[14];
		for (int i = 0; i < 14; i++)
			file >> times[i];

		int totalBooking, totalCompleted;
		double totalAmount;
		file >> totalBooking >> totalCompleted >> totalAmount;
		file.ignore(); // eat trailing newline before next getline()

		if (fileID == id) {
			file.close();
			cout << fixed << setprecision(2);
			for (int i = 0; i < 14; i++) {
				if (times[i] != 0) {
					string sName;
					double price;
					getServiceInfoByPosition(i / 2, sName, price);

					cout << sName << " - Booking Time: " << times[i];
					if (price != -1) {
						cout << " - RM" << price;
					}
					else {
						cout << " - (price not found)";
					}
					cout << endl;
				}
			}
			return totalAmount;
		}
	}
	file.close();
	return -1;
}

