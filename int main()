// Adds a new payment record, or overwrites the existing one for that
// customerID if they already have a record. Then saves to file.
void storeOrUpdatePayment(Payment p) {
	int ids = findPaymentIndex(p.customerID);
	if (ids != -1) {
		payments[ids] = p;
	}
	else if (paymentCount < MAX_PAYMENTS) {
		payments[paymentCount] = p;
		paymentCount++;
	}
	else {
		cout << "Error: Payment record limit reached." << endl;
		return;
	}
	savePaymentsToFile();
}
