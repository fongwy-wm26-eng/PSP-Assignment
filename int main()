	cout << "Total Amount: RM" << p.totalAmount << endl;
	cout << "Deposit: RM" << p.deposit << endl;
	cout << "Balance: RM" << p.balance << endl;
	cout << "Status: " << p.status << endl;
	do {
		cout << "\n1. Generate Invoice" << endl;
		cout << "2. Update Payment Status" << endl;
		cout << "0. Return to Payment Menu" << endl;
		cout << "Enter your choice: ";
		choice = getMenuChoice(1, 2);
		if (choice == 1) {
			invoice(p);
			break;
		}
		else if (choice == 2) {
