// WEI YUAN PART (Transaction Management)
void paymentMenu() {
	int choice;
	Payment p;
	do {
		cout << "==========================================" << endl;
		cout << "          Transaction Management         " << endl;
		cout << "==========================================" << endl;
		cout << "1. Process Payment" << endl;
		cout << "2. Display Payment Details" << endl;
		cout << "3. Generate Invoice" << endl;
		cout << "4. Update Payment Status" << endl;
		cout << "5. View Payment History" << endl;
		cout << "6. Search for a Payment" << endl;
		cout << "0. Return to Main Menu" << endl;
		cout << "==========================================" << endl;
		choice = getMenuChoice(1, 6);
		switch (choice) {
		case 1:
			p = processPayment(p);
			// Only persist real records - skip blanks left by a cancelled/failed lookup
			if (!p.customerID.empty())
				storeOrUpdatePayment(p);
			break;
		case 2:
			displayPaymentDetails(p);
			break;
		case 3:
			invoice(p);
			break;
		case 4:
			p = updatePaymentStatus(p);
			if (!p.customerID.empty())
				storeOrUpdatePayment(p);
			break;
		case 5:
			paymentHistory();
			break;
		case 6:
			searchPayment();
			break;
		default:
			cout << "Returning to Main Menu..." << endl;
		}
	} while (choice != 0);
}

// Handles the "choose payment method" sub-menu shared by both the deposit
// and full-payment flows. Sets p.status to "Fully Paid" or "Deposit Paid"
// (based on isFullPayment) and bumps the right method counter ONLY when a
// payment actually completes. Returns true if payment completed, false if
// the user backed out.
bool collectPaymentMethod(Payment& p, bool isFullPayment) {
	int choice;
	bool completed = false;
	do {
		cout << "\nChoose payment method: " << endl;
		cout << "1. Cash" << endl;
		cout << "2. Online Banking" << endl;
		cout << "3. E-Wallet" << endl;
		cout << "4. Help" << endl;
		cout << "0. Return to Payment Menu" << endl;
		cout << "Enter your choice: ";
		choice = getMenuChoice(1, 4);
		char input;
		switch (choice) {
		case 1:
			cout << "\nPayment Method: Cash" << endl;
			cout << "Please pay the amount in cash at our office." << endl;
			cout << "\nPress any key after you have finished the payment or press '0' to return to Payment Menu" << endl;
			cin >> input;
			clearInputBuffer();
			if (input == '0')
				break;
			p.status = isFullPayment ? "Fully Paid" : "Deposit Paid";
			p.cashCount++;
			completed = true;
			cout << "\nPayment successful! Thank you for your payment." << endl;
			break;

		case 2:
			cout << "\nPayment Method: Online Banking" << endl;
			cout << "Please transfer the amount to the following bank account: " << endl;
			cout << "Bank: Maybank" << endl;
			cout << "Account Number: 1234567890" << endl;
			cout << "Account Name: ABC Company" << endl;
			cout << "Please include your name and invoice number in the transfer reference." << endl;
			cout << "\nPress any key after you have finished the payment or press '0' to return to Payment Menu" << endl;
			cin >> input;
			clearInputBuffer();
			if (input == '0')
				break;
			p.status = isFullPayment ? "Fully Paid" : "Deposit Paid";
			p.onlineBankingCount++;
			completed = true;
			cout << "\nPayment successful! Thank you for your payment.\n" << endl;
			break;

		case 3:
			cout << "\nPayment Method: E-Wallet" << endl;
			cout << "Please transfer the amount to the following e-wallet account: " << endl;
			cout << "Account Number: 0123456789" << endl;
			cout << "Account Name: ABC Company" << endl;
			cout << "\nPress any key after you have finished the payment or press '0' to return to Payment Menu" << endl;
			cin >> input;
			clearInputBuffer();
			if (input == '0')
				break;
			p.status = isFullPayment ? "Fully Paid" : "Deposit Paid";
			p.eWalletCount++;
			completed = true;
			cout << "\nPayment successful! Thank you for your payment.\n" << endl;
			break;

		case 4:
			cout << "\nPlease contact us if you need assistance." << endl;
			cout << "Email: abc@gmail.com" << endl;
			cout << "Phone: 012-3456789" << endl;
			cout << "Press any key to continue..." << endl;
			cin.get();
			break;

		default:
			cout << "\nReturning to Payment Menu..." << endl;
			break;
		}
	} while (choice != 0 && !completed);

	if (completed) {
		char invoiceChoice;
		cout << "Press 1 to generate invoice or 0 to return to Payment Menu" << endl;
		cin >> invoiceChoice;
		clearInputBuffer();
		if (invoiceChoice == '1') {
			invoice(p);
		}
	}
	return completed;
}

Payment processPayment(Payment p) {
	int choice;

	cout << "\n===== Payment =====\n";
	cout << "Enter Customer ID: ";
	cin >> p.customerID;
	clearInputBuffer();

	cout << "Customer Name: " << getCustomerName(p.customerID) << endl;

	// Check whether this customer already has a payment record, and what
	// its current status is, BEFORE starting a new payment flow.
	int existingIndex = findPaymentIndex(p.customerID);
	if (existingIndex != -1) {
		p = payments[existingIndex];

		if (p.status == "Fully Paid") {
			cout << "\nThis booking has already been fully paid. You have no payment due." << endl;
			return p;
		}
	}

	// Look up the amount from the booking, and print the service
	double amount = showCustomerBooking(p.customerID);
	if (amount == -1) {
		cout << "No booking found for this Customer ID. Please create a booking first." << endl;
		p.customerID = ""; // so paymentMenu/storeOrUpdatePayment don't save a blank record
		return p;
	}
	p.totalAmount = amount;
	cout << "Total Amount: RM" << fixed << setprecision(2) << p.totalAmount << endl;
	cout << "Payment Status: " << p.status << endl;

	bool completed = false;

	if (p.status == "Deposit Paid") {
		// Deposit already on file - what's left must be paid in full now.
		p.balance = p.totalAmount - p.deposit;
		cout << "\nA deposit has already been paid for this booking." << endl;
		cout << "Remaining balance to pay: RM" << p.balance << endl;
		completed = collectPaymentMethod(p, true);
	}
	else {
		do {
			cout << "Would you prefer to secure your booking with a deposit today, or take care of the full payment now?" << endl;
			cout << "1. Pay Deposit (50% of total amount)" << endl;
			cout << "2. Pay Full Amount" << endl;
			cout << "0. Return to Payment Menu" << endl;
			cout << "Enter your choice: ";
			choice = getMenuChoice(1, 2);
			switch (choice) {
			case 1:
				p.deposit = p.totalAmount * 0.50;
				p.balance = p.totalAmount - p.deposit;
				cout << "Deposit (50%): RM" << p.deposit << endl;
				cout << "Remaining balance to be paid after service: RM" << p.balance << endl;
				completed = collectPaymentMethod(p, false);
				break;
			case 2:
				p.deposit = 0;
				p.balance = 0;
				completed = collectPaymentMethod(p, true);
				break;
			default:
				cout << "Invalid choice. Please try again." << endl;
			}
		} while (choice != 0 && !completed);
	}

	// Only count revenue once a payment has actually gone through.
	if (completed) {
		p.totalEarn += p.totalAmount;
	}

	return p;
}

