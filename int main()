// Load Customer Data
void loadFromFile() {
	ifstream file("customers.txt");
	if (!file.is_open()) {
		return;
	}

	customerCount = 0;
	string id, name, phone, petName, petTypeStr;

	while (customerCount < MAX_CUSTOMERS && getline(file, id)) {
		if (id.empty()) continue;

		getline(file, name);
		getline(file, phone);
		getline(file, petName);
		getline(file, petTypeStr);

		customers[customerCount].id = id;
		customers[customerCount].name = name;
		customers[customerCount].phone = phone;
		customers[customerCount].petName = petName;
		customers[customerCount].petType = stringToPetType(petTypeStr);

		customerCount++;
	}
	file.close();
}

void loadPaymentsFromFile() {
	ifstream file("payments.txt");
	if (!file.is_open())
		return;

	paymentCount = 0;
	string id, status;
	double amount, deposit, balance;

	while (paymentCount < MAX_PAYMENTS && getline(file, id)) {
		if (id.empty())
			continue;

		file >> amount >> deposit >> balance;
		file.ignore(); // clear leftover newline before the next getline()
		getline(file, status);

		payments[paymentCount].customerID = id;
		payments[paymentCount].totalAmount = amount;
		payments[paymentCount].deposit = deposit;
		payments[paymentCount].balance = balance;
		payments[paymentCount].status = status;
		paymentCount++;
	}
	file.close();
}

